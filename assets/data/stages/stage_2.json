{
  "id": "stage_2",
  "name": "Rừng Sương Mù",
  "name_en": "Mistwood Forest",
  "act": 2,
  "difficulty": 2,
  "description": "Hồi 2 – Những nỗi sợ bị lãng quên. Player lần theo manh mối, mở khóa khu rừng tối và đầm lầy. Mỗi vùng đất tiết lộ một phần quá khứ của các linh hồn. Cuối stage, một trong bốn linh hồn chính bị 'ăn mòn' hoàn toàn — trở thành boss The Whispering Shade.",

  "presentation": {
    "background": "mistwood_forest_bg",
    "music": "forest_dark_ambient",
    "intro_text": "Sương Mù Đen dày hơn ở đây. Cây cối thì thầm bằng giọng nói của những người đã chết.",
    "outro_text_win": "Whispering Shade tan biến trong tiếng khóc — bạn nhận ra giọng nói đó từng là một trong số bạn. Mảnh đá đen thứ hai rơi xuống, cùng nhịp với tim bạn.",
    "outro_text_lose": "Bạn quên dần chính mình. Khi tỉnh dậy, không ai còn nhớ tên các hero đã ngã."
  },

  "layout": {
    "type": "layered_tree",
    "edge_topology": "fully_connected",
    "num_layers": 5,
    "total_nodes": 13,
    "paths_per_run": 6,
    "layer_node_counts": [1, 3, 3, 3, 2, 1],

    "first_node_fixed": {
      "type": "combat",
      "label": "L1.A",
      "enemy_pool": ["enemy_03"],
      "variants_allowed": ["Base", "Tank"],
      "min_enemies": 2,
      "max_enemies": 2,
      "comment": "Trận mở màn dùng Shadow Wisp (theme Sương Mù). 2 con để báo hiệu độ khó tăng so Stage 1."
    },

    "last_node_fixed": {
      "type": "boss",
      "label": "BOSS",
      "boss_id": "enemy_b02",
      "intro_text": "Một bóng đen lạnh lẽo bước ra từ sương mù. Khuôn mặt nó mơ hồ — gần như là một trong các bạn đồng hành của bạn..."
    },

    "middle_layers": [
      {
        "name": "L2",
        "num_nodes": 3,
        "edges_in": "fully_connected_from_layer_1",
        "edges_out": "fully_connected_to_next_layer",
        "node_generation": {
          "type": "random_from_pool_weighted",
          "weights": { "combat": 50, "event": 25, "rest": 15, "reward": 10 }
        }
      },
      {
        "name": "L3",
        "num_nodes": 3,
        "edges_in": "fully_connected_from_layer_2",
        "edges_out": "fully_connected_to_next_layer",
        "node_generation": {
          "type": "random_from_pool_weighted",
          "weights": { "combat": 35, "event": 30, "rest": 15, "reward": 15, "elite": 5 }
        }
      },
      {
        "name": "L4",
        "num_nodes": 3,
        "edges_in": "fully_connected_from_layer_3",
        "edges_out": "fully_connected_to_next_layer",
        "node_generation": {
          "type": "random_from_pool_weighted",
          "weights": { "combat": 30, "event": 30, "rest": 20, "reward": 15, "elite": 5 }
        }
      },
      {
        "name": "L5",
        "num_nodes": 2,
        "edges_in": "fully_connected_from_layer_4",
        "edges_out": "all_to_boss",
        "node_generation": {
          "type": "random_from_pool_weighted",
          "weights": { "rest": 35, "reward": 30, "event": 25, "combat": 10 },
          "constraint": "if_layer_5_node_is_combat: must_use_pre_boss_pool"
        }
      }
    ]
  },

  "rules": [
    "no_consecutive_rest",
    "no_consecutive_reward",
    "no_consecutive_event_unless_30%",
    "max_combat_per_run: 4",
    "min_event_per_run: 2",
    "min_rest_per_run: 1",
    "elite_node_max_per_run: 1",
    "if_player_has_full_party_hp_before_boss: spawn_extra_reward_node",
    "if_party_avg_hp_below_30%_at_layer_4: bias_layer_5_to_rest"
  ],

  "pools": {
